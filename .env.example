# Which provider receives form submissions: "formspree" (default) or "webhook".
FORM_PROVIDER=formspree

# Formspree form IDs (the part after https://formspree.io/f/), one per form.
FORMSPREE_BALLCLUB_ID=
FORMSPREE_TOWNVOTE_ID=
FORMSPREE_CONTACT_ID=

# Only used when FORM_PROVIDER=webhook. Receives POST { form, data, submittedAt } as JSON.
FORM_WEBHOOK_URL=
